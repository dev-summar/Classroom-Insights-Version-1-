# Frontend only: SPA fallback for /site/classroom/*
# Place this in the folder served at /site/classroom/ (e.g. htdocs/site/classroom/.htaccess)
# Backend /classrooms/* is handled by the API server, not this file.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /site/classroom/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /site/classroom/index.html [L]
</IfModule>
