# SPA fallback: serve index.html for routes under /site/classroom/
# Place this file in your document root for /site/classroom/ (e.g. htdocs/site/classroom/.htaccess)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /site/classroom/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /site/classroom/index.html [L]
</IfModule>
